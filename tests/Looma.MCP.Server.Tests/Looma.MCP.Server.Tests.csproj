<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Looma.MCP.Server\Looma.MCP.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApiKeyAuthorizerTests exercises Microsoft.AspNetCore.Http.HeaderDictionary
