<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Looma.CLI</RootNamespace>
    <AssemblyName>looma</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Looma.Application\Looma.Application.csproj" />

    <!-- Composition-root exception to "clients depend only on Application"
         (CLAUDE.md rule 1): Program.cs is the outermost composition root for
         standalone mode and is where DI gets wired to concrete
         implementations — the brief's own architecture section says exactly
         this ("Only Program.cs DI wiring changes between shapes"). No
         command handler under Commands/ references these projects; only
         Program.cs does. MCP-client mode (a later milestone) will add a
         second wiring path here that references Looma.MCP.Client instead. -->
    <ProjectReference Include="..\Looma.Infrastructure.VectorStore.Qdrant\Looma.Infrastructure.VectorStore.Qdrant.csproj" />
    <ProjectReference Include="..\Looma.Infrastructure.Llm\Looma.Infrastructure.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions pinned centrally in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

</Project>
